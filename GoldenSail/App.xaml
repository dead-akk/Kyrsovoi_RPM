<Application x:Class="GoldenSail.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenSail"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="SidebarBrush" Color="#1a1d29"></SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush" Color="#6b2737"></SolidColorBrush>
        <SolidColorBrush x:Key="GoldBrush" Color="#c9a961"></SolidColorBrush>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#8b6f47"></SolidColorBrush>
        <SolidColorBrush x:Key="LightBgBrush" Color="#f8f4ef"></SolidColorBrush>
        <SolidColorBrush x:Key="TextLightBrush" Color="#e8dcc8"></SolidColorBrush>

        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1a1d29" Offset="0"></GradientStop>
            <GradientStop Color="#6b2737" Offset="1"></GradientStop>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#c9a961" Offset="0"></GradientStop>
            <GradientStop Color="#8b6f47" Offset="1"></GradientStop>
        </LinearGradientBrush>

        <Style TargetType="TextBlock" x:Key="TextOne">
            <Setter Property="Foreground" Value="#e8dcc8"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="16"></Setter>
            <Setter Property="FontFamily" Value="Times New Roman"></Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="TextMain">
            <Setter Property="Foreground" Value="#c9a961"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="FontSize" Value="24"></Setter>
            <Setter Property="FontFamily" Value="Times New Roman"></Setter>
        </Style>

        <Style TargetType="Button" x:Key="ButtonOne">
            <Setter Property="Foreground" Value="#1a1d29"></Setter>
            <Setter Property="Height" Value="32"></Setter>
            <Setter Property="FontFamily" Value="Times New Roman"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Background" Value="{StaticResource GoldGradient}"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="#c9a961" BorderThickness="1"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#c9a961"></Setter>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#2a2d39"></SolidColorBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SidebarButton">
            <Setter Property="Foreground" Value="#e8dcc8"></Setter>
            <Setter Property="Height" Value="42"></Setter>
            <Setter Property="FontFamily" Value="Times New Roman"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="FontWeight" Value="Normal"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#c9a961"></Setter>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#2a2d39"></SolidColorBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>