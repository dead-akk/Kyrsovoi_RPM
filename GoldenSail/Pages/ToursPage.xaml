<Page x:Class="GoldenSail.Pages.ToursPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Каталог туров">
    <Page.Resources>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Background" Value="#6b2737"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6b2737"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>
    <Grid Background="#f8f4ef">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="20,14" BorderBrush="#ddd6cc" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Каталог туров" FontFamily="Times New Roman" FontSize="22" FontWeight="Bold" Foreground="#1a1d29"/>
                    <TextBlock Text="Выберите направление для следующего путешествия" FontFamily="Times New Roman" FontSize="13" Foreground="#77736e" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBox Name="TBoxSearch" Width="180" Height="30" Padding="6,3" VerticalContentAlignment="Center" Margin="0,0,8,0"
                             FontFamily="Times New Roman" FontSize="14" TextChanged="TBoxSearch_TextChanged" ToolTip="Поиск по названию, стране или отелю"/>
                    <ComboBox Name="ComboCountry" Width="130" Height="30" Margin="0,0,8,0" FontFamily="Times New Roman" FontSize="14"
                              SelectionChanged="ComboCountry_SelectionChanged"/>
                    <ComboBox Name="ComboSort" Width="145" Height="30" Margin="0,0,8,0" FontFamily="Times New Roman" FontSize="14"
                              SelectionChanged="ComboSort_SelectionChanged">
                        <ComboBoxItem Content="По популярности"/>
                        <ComboBoxItem Content="Сначала дешевле"/>
                        <ComboBoxItem Content="Сначала дороже"/>
                    </ComboBox>
                    <Button Content="Обновить" Height="30" Click="BtnRefresh_Click" Style="{StaticResource PlainButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
            <StackPanel Margin="20,16">
                <ItemsControl Name="LViewTours">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="255" Background="White" Margin="0,0,14,16" BorderBrush="#ddd6cc" BorderThickness="1">
                                <StackPanel>
                                    <Grid Height="150" ClipToBounds="True">
                                        <Image Source="{Binding FotoImage}" Stretch="UniformToFill"/>
                                        <Border Background="#6b2737" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="Горящий тур" Foreground="White" FontFamily="Times New Roman" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Strana}" Foreground="#8b6f47" FontFamily="Times New Roman" FontSize="13"/>
                                        <TextBlock Text="{Binding Nazvanie}" FontFamily="Times New Roman" FontSize="17" FontWeight="Bold" Foreground="#1a1d29" TextWrapping="Wrap" Margin="0,3,0,2"/>
                                        <TextBlock Text="{Binding Otel}" FontFamily="Times New Roman" FontSize="13" Foreground="#77736e" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Tsena, StringFormat={}{0:N0} ₽}" FontFamily="Times New Roman" FontSize="17" FontWeight="Bold" Foreground="#6b2737" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Подробнее" Tag="{Binding}" Click="BtnDetails_Click" Style="{StaticResource PlainButton}" Height="30"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
