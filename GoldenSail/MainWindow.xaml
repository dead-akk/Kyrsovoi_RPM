<Window x:Class="GoldenSail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldenSail"
        mc:Ignorable="d"
        Title="Golden Sail – Туристическое агентство" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,20" HorizontalAlignment="Center">
                    <Image Source="/Icon/Logo.png" Width="60" Height="60" Margin="0,0,0,10"></Image>
                    <TextBlock Text="Golden Sail" Style="{StaticResource TextMain}" 
                               HorizontalAlignment="Center" FontSize="20"></TextBlock>
                    <TextBlock Text="Турагентство" Style="{StaticResource TextOne}" 
                               HorizontalAlignment="Center" FontSize="11" FontWeight="Normal"></TextBlock>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Выход" 
                        Name="BtnLogout" Click="BtnLogout_Click"
                        Style="{StaticResource SidebarButton}" 
                        Margin="0,0,0,15" Foreground="#c9a961"></Button>

                <StackPanel VerticalAlignment="Top">
                    <Button Content="Каталог туров" Name="BtnTours" Click="BtnTours_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Бронирования" Name="BtnBookings" Click="BtnBookings_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Клиенты" Name="BtnClients" Click="BtnClients_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Сотрудники" Name="BtnEmployees" Click="BtnEmployees_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Оплаты" Name="BtnPayments" Click="BtnPayments_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Отчёты" Name="BtnReports" Click="BtnReports_Click" Style="{StaticResource SidebarButton}"></Button>
                    <Button Content="Журнал действий" Name="BtnLog" Click="BtnLog_Click" Style="{StaticResource SidebarButton}"></Button>
                </StackPanel>
            </DockPanel>
        </Border>


        <Grid Grid.Column="1" Background="{StaticResource LightBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Name="TbEmployeeName" Text="Сотрудник" 
                                       FontFamily="Times New Roman" FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Right"></TextBlock>
                            <TextBlock Name="TbEmployeeRole" Text="Должность" 
                                       FontFamily="Times New Roman" FontSize="12" 
                                       HorizontalAlignment="Right"></TextBlock>
                        </StackPanel>
                        <Border Width="38" Height="38" CornerRadius="19" 
                                Background="{StaticResource GoldGradient}">
                            <TextBlock Text="GS" FontFamily="Times New Roman" FontSize="14" 
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Name="TbPageTitle" Text="Каталог туров"
                               Visibility="Collapsed"/>
                </DockPanel>
            </Border>

            <Frame Grid.Row="1" Name="FrameMain" NavigationUIVisibility="Hidden" 
                   Background="Transparent"></Frame>
        </Grid>
    </Grid>
</Window>
